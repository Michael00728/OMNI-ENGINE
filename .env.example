# Copy to .env for local development. Never commit real credentials.
OMNI_ENVIRONMENT=development
OMNI_API_HOST=0.0.0.0
OMNI_API_PORT=8000
OMNI_LOG_LEVEL=INFO
OMNI_CORS_ORIGINS=["http://localhost:3000"]
OMNI_DOCS_ENABLED=true
POSTGRES_DB=omni_engine
POSTGRES_USER=omni_admin
POSTGRES_PASSWORD=replace_with_a_unique_local_admin_password
OMNI_MIGRATOR_DB_PASSWORD=replace_with_a_separate_url_safe_migration_password
OMNI_APP_DB_PASSWORD=replace_with_a_different_url_safe_runtime_password
# OMNI_MIGRATION_DATABASE_URL is intentionally not stored here. Supply it only
# to the one-off Alembic migration command using the migration-role credential.
