# Copy to .env for local development. Never commit real credentials.
OMNI_ENVIRONMENT=development
OMNI_API_HOST=0.0.0.0
OMNI_API_PORT=8000
OMNI_LOG_LEVEL=INFO
OMNI_DATABASE_URL=postgresql+psycopg://omni:omni_dev_only@db:5432/omni_engine
OMNI_CORS_ORIGINS=http://localhost:3000
OMNI_DOCS_ENABLED=true
POSTGRES_DB=omni_engine
POSTGRES_USER=omni
POSTGRES_PASSWORD=replace_with_a_local_only_password
